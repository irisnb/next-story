{
  "name": "next-story",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "npm run tauri dev",
    "tauri:build": "npm run tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:frontend": "node --test tests/*.test.ts",
    "test:reliability": "node --test sidecar/reliability/tests/*.test.mjs",
    "test:driver": "node --test sidecar/driver/tests/*.test.mjs",
    "test:validation": "node --test sidecar/validation/tests/*.test.mjs",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "clippy:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "package:check": "node scripts/check-package-resources.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:frontend && npm run test:reliability && npm run test:driver && npm run test:validation && npm run build && npm run fmt:rust && npm run clippy:rust && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-font-family": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "~2.11.4",
    "@types/node": "^26.6.2",
    "eslint": "^10.8.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "~6.4.3"
  }
}
