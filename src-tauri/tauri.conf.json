{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Next Story",
  "version": "0.2.0",
  "identifier": "com.nextstory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run package:check",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Next Story",
        "width": 1024,
        "height": 670,
        "minWidth": 1024,
        "minHeight": 670,
        "center": true,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost blob:; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../sidecar/node_modules/": "sidecar/node_modules/",
      "../sidecar/node-runtime/": "sidecar/node-runtime/",
      "../sidecar/driver/": "sidecar/driver/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3REEzODdBQUVDODFBQTcKUldTbkdzaXVlamphdDBKSFJmbXRPMzRvd3l2WG1scHZsdUYrT3M4cXVFNFdmTE5lL2xZdVFQRWUK",
      "endpoints": [
        "https://github.com/irisnb/next-story/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
